#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Home Assistant Community Add-on: Studio Code Server
# Runs the code-server
# ==============================================================================
declare -a options
declare config_path

bashio::log.info 'Starting code-server...'

config_path="/config"
if bashio::config.has_value 'config_path'; then
    config_path=$(bashio::config 'config_path')
fi

options+=(--port 1337)
options+=(--user-data-dir "/data/vscode")
options+=(--extensions-dir "/data/vscode/extensions")
options+=(--host 0.0.0.0)
options+=(--disable-telemetry)
options+=(--disable-update-check)

# Disable code authentication, we use HA authentication
options+=(--auth none)

# Export env variables for the Home Assistant extension
export HASS_SERVER="http://supervisor/core"
export HASS_TOKEN="${SUPERVISOR_TOKEN:-}"

# Persist Claude Code auth/config in the add-on's /data volume, so it
# survives add-on restarts and image updates (container root fs does not).
export CLAUDE_CONFIG_DIR="/data/claude"
export ANTHROPIC_CONFIG_DIR="/data/claude"
mkdir -p "${CLAUDE_CONFIG_DIR}"

# Log Claude setup for debugging
if command -v claude >/dev/null 2>&1; then
    bashio::log.info "Claude CLI found: $(claude --version 2>&1 || echo 'version check failed')"
else
    bashio::log.warning "Claude CLI not found in PATH"
fi

# Optionally route Claude Code through a LiteLLM (or other Anthropic-
# compatible) gateway instead of api.anthropic.com.
if bashio::config.has_value 'anthropic_base_url'; then
    export ANTHROPIC_BASE_URL="$(bashio::config 'anthropic_base_url')"
fi
if bashio::config.has_value 'anthropic_auth_token'; then
    export ANTHROPIC_API_KEY="$(bashio::config 'anthropic_auth_token')"
fi
if bashio::config.has_value 'anthropic_model'; then
    export ANTHROPIC_MODEL="$(bashio::config 'anthropic_model')"
fi

# Log API configuration
if [[ -n "${ANTHROPIC_BASE_URL}" ]]; then
    bashio::log.info "Using custom Anthropic API: ${ANTHROPIC_BASE_URL}"
fi
if [[ -n "${ANTHROPIC_MODEL}" ]]; then
    bashio::log.info "Using model: ${ANTHROPIC_MODEL}"
fi

# Run the code server
cd "${config_path}" || bashio::exit.nok "Could not change working directory"
exec code-server "${options[@]}" "${config_path}"
