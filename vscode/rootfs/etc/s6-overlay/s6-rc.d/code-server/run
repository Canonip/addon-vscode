#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Home Assistant Community Add-on: Studio Code Server
# Runs the code-server
# ==============================================================================
declare -a options
declare config_path

bashio::log.info 'Starting code-server...'

config_path="/config"
if bashio::config.has_value 'config_path'; then
    config_path=$(bashio::config 'config_path')
fi

options+=(--port 1337)
options+=(--user-data-dir "/data/vscode")
options+=(--extensions-dir "/data/vscode/extensions")
options+=(--host 0.0.0.0)
options+=(--disable-telemetry)
options+=(--disable-update-check)

# Disable code authentication, we use HA authentication
options+=(--auth none)

# Export env variables for the Home Assistant extension
export HASS_SERVER="http://supervisor/core"
export HASS_TOKEN="${SUPERVISOR_TOKEN:-}"

# Persist opencode config in the add-on's /data volume so it survives restarts.
mkdir -p /data/opencode
ln -sfn /data/opencode /root/.config/opencode

# Write opencode config.json from addon options
if bashio::config.has_value 'ai_base_url' || bashio::config.has_value 'ai_api_key'; then
    BASE_URL=""
    API_KEY=""
    MODEL="openai/gpt-4o"

    if bashio::config.has_value 'ai_base_url'; then
        BASE_URL="$(bashio::config 'ai_base_url')"
    fi
    if bashio::config.has_value 'ai_api_key'; then
        API_KEY="$(bashio::config 'ai_api_key')"
    fi
    if bashio::config.has_value 'ai_model'; then
        MODEL="$(bashio::config 'ai_model')"
    fi

    cat > /data/opencode/config.json <<EOF
{
  "\$schema": "https://opencode.ai/config.json",
  "model": "${MODEL}",
  "provider": {
    "openai": {
      "apiKey": "${API_KEY}",
      "baseURL": "${BASE_URL}"
    }
  }
}
EOF
    bashio::log.info "opencode config written (model: ${MODEL}, baseURL: ${BASE_URL})"
fi

# Log opencode availability
if command -v opencode >/dev/null 2>&1; then
    bashio::log.info "opencode CLI found: $(opencode --version 2>&1 || echo 'version check failed')"
else
    bashio::log.warning "opencode CLI not found in PATH"
fi

# Run the code server
cd "${config_path}" || bashio::exit.nok "Could not change working directory"
exec code-server "${options[@]}" "${config_path}"
